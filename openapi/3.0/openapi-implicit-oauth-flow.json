{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "authorizationUrl",
    "scopes"
  ],
  "properties": {
    "authorizationUrl": {
      "type": "string",
      "format": "uri-reference"
    },
    "refreshUrl": {
      "type": "string",
      "format": "uri-reference"
    },
    "scopes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false
}
