{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "deprecated": {
      "type": "boolean",
      "default": false
    },
    "allowEmptyValue": {
      "type": "boolean",
      "default": false
    },
    "style": {
      "type": "string",
      "enum": [
        "simple"
      ],
      "default": "simple"
    },
    "explode": {
      "type": "boolean"
    },
    "allowReserved": {
      "type": "boolean",
      "default": false
    },
    "schema": {
      "$ref": "openapi-schema-or-reference.json"
    },
    "content": {
      "allOf": [
        {
          "$ref": "openapi-content.json"
        }
      ],
      "minProperties": 1,
      "maxProperties": 1
    },
    "example": {},
    "examples": {
      "$ref": "openapi-examples.json"
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "openapi-example-xor-examples.json"
    },
    {
      "$ref": "openapi-schema-xor-content.json"
    }
  ]
}
