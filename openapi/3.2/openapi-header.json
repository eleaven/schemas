{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "https://spec.openapis.org/oas/v3.2#header-object",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "required": {
      "default": false,
      "type": "boolean"
    },
    "deprecated": {
      "default": false,
      "type": "boolean"
    },
    "schema": {
      "$dynamicRef": "openapi-schema.json#meta"
    },
    "content": {
      "$ref": "openapi-content.json",
      "minProperties": 1,
      "maxProperties": 1
    }
  },
  "oneOf": [
    {
      "required": [
        "schema"
      ]
    },
    {
      "required": [
        "content"
      ]
    }
  ],
  "dependentSchemas": {
    "schema": {
      "properties": {
        "style": {
          "default": "simple",
          "const": "simple"
        },
        "explode": {
          "default": false,
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "openapi-example-xor-examples.json"
    },
    {
      "$ref": "openapi-specification-extensions.json"
    }
  ],
  "unevaluatedProperties": false
}
