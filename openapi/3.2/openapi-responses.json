{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "https://spec.openapis.org/oas/v3.2#responses-object",
  "type": "object",
  "properties": {
    "default": {
      "$ref": "openapi-response-or-reference.json"
    }
  },
  "patternProperties": {
    "^[1-5](?:[0-9]{2}|XX)$": {
      "$ref": "openapi-response-or-reference.json"
    }
  },
  "minProperties": 1,
  "$ref": "openapi-specification-extensions.json",
  "unevaluatedProperties": false,
  "if": {
    "$comment": "either default, or at least one response code property must exist",
    "patternProperties": {
      "^[1-5](?:[0-9]{2}|XX)$": false
    }
  },
  "then": {
    "required": [
      "default"
    ]
  }
}
